---
import TagChip from './TagChip.astro';
import Wordmark from './Wordmark.astro';
import { getTags } from '../utils/posts';

interface Props {
	/** ナビの現在地 */
	current?: 'articles' | 'about';
	/** タグページのとき、点灯させるタグのスラッグ */
	activeTag?: string;
}

const { current, activeTag } = Astro.props;
const tags = await getTags();
---

<header>
	<div class="shell bar">
		<Wordmark />
		<nav class="links">
			<a href="/articles/" class:list={['navlink', { on: current === 'articles' }]}>記事一覧</a>
			<a href="/about/" class:list={['navlink', { on: current === 'about' }]}>about</a>
			<a href="/rss.xml" class="navlink icon" aria-label="RSS">
				<svg
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M4 11a9 9 0 0 1 9 9"></path>
					<path d="M4 4a16 16 0 0 1 16 16"></path>
					<circle cx="5" cy="19" r="1.5"></circle>
				</svg>
			</a>
		</nav>
	</div>
	{
		tags.length > 0 && (
			<div class="rail">
				<div class="shell rail-inner">
					<span class="rail-label">TAGS</span>
					<div class="chips">
						{tags.map((tag) => (
							<TagChip tag={tag.name} active={tag.slug === activeTag} />
						))}
					</div>
				</div>
			</div>
		)
	}
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: var(--bg);
		border-bottom: 1px solid var(--border);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		height: 68px;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 26px;
	}
	.navlink {
		font-family: var(--font-mono);
		font-size: 15px;
		color: var(--dim);
		text-decoration: none;
		padding-bottom: 3px;
		border-bottom: 2px solid transparent;
		transition: color 0.18s ease;
	}
	.navlink:hover {
		color: var(--text);
	}
	.navlink.on {
		color: var(--text);
		border-bottom-color: var(--accent);
	}
	.icon {
		display: flex;
		padding-bottom: 0;
		border-bottom: 0;
	}
	.rail {
		border-top: 1px solid var(--border-soft);
		overflow-x: auto;
	}
	.rail-inner {
		display: flex;
		align-items: center;
		gap: 14px;
		padding-top: 10px;
		padding-bottom: 10px;
	}
	.rail-label {
		flex-shrink: 0;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.16em;
		color: var(--faint);
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
	}
	@media (max-width: 900px) {
		.bar {
			height: 58px;
			gap: 16px;
		}
		.links {
			gap: 16px;
		}
		.navlink {
			font-size: 13px;
			white-space: nowrap;
		}
		.rail-inner {
			flex-wrap: nowrap;
			white-space: nowrap;
		}
		.chips {
			flex-wrap: nowrap;
		}
	}
</style>
