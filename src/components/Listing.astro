---
import Pagination from './Pagination.astro';
import PostGrid from './PostGrid.astro';
import type { Post } from '../utils/posts';

interface Props {
	/** 見出しの上に出すパス表記 */
	eyebrow: string;
	/** 件数などの補足行 */
	meta: string;
	/** このページに並べる記事 */
	posts: Post[];
	/** ページ送りの対象となる総件数 */
	total: number;
	current: number;
	/** 末尾スラッシュ込みのベースパス。例: /tags/ci/ */
	base: string;
}

const { eyebrow, meta, posts, total, current, base } = Astro.props;
---

<main class="shell">
	<section class="head">
		<div class="eyebrow">{eyebrow}</div>
		<slot name="heading" />
		<p class="count">{meta}</p>
	</section>
	<section>
		<PostGrid posts={posts} />
		<Pagination current={current} total={total} base={base} />
	</section>
</main>

<style>
	.head {
		padding: 80px 0 56px 0;
	}
	.head :global(h1) {
		margin: 14px 0 0 0;
		font-size: 2.441em;
	}
	.count {
		margin: 14px 0 0 0;
		font-family: var(--font-mono);
		font-size: 15px;
		color: var(--dim);
	}
	@media (max-width: 900px) {
		.head {
			padding: 48px 0 36px 0;
		}
	}
</style>
