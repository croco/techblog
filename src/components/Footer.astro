---
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();
---

<footer>
	<div class="shell top">
		<div class="brand">
			<Wordmark size={16} />
			<p>各リポジトリのコードとアイデアを、1つずつ記事にしています。</p>
		</div>
		<nav class="links">
			<a href="/articles/">記事一覧</a>
			<a href="/about/">about</a>
			<a href="/rss.xml">rss</a>
			<a href="https://github.com/croco">github</a>
		</nav>
	</div>
	<div class="rule">
		<div class="shell copy">© {year} croco</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		margin-top: 104px;
	}
	.top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 48px;
		padding-top: 52px;
		padding-bottom: 64px;
	}
	.brand {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.brand p {
		margin: 0;
		max-width: 30ch;
		font-size: 16px;
		line-height: 1.6;
		color: var(--dim);
	}
	.links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 24px;
	}
	.links a {
		font-family: var(--font-mono);
		font-size: 14px;
		color: var(--dim);
		text-decoration: none;
		transition: color 0.18s ease;
	}
	.links a:hover {
		color: var(--text);
	}
	.rule {
		border-top: 1px solid var(--border-soft);
	}
	.copy {
		padding-top: 18px;
		padding-bottom: 18px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--faint);
	}
	@media (max-width: 900px) {
		footer {
			margin-top: 64px;
		}
		.top {
			flex-direction: column;
			gap: 24px;
			padding-top: 36px;
			padding-bottom: 36px;
		}
	}
</style>
