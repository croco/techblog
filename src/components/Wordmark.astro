---
interface Props {
	size?: number;
}

const { size = 17 } = Astro.props;
---

<a
	href="/"
	class="wordmark"
	style={`--wm-size: ${size}px; --wm-caret-w: ${Math.round(size * 0.52)}px; --wm-caret-h: ${Math.round(size * 1.1)}px;`}
>
	<span class="org">croco</span><span class="slash">/</span><span>techblog</span><span
		class="caret"
		aria-hidden="true"></span>
</a>

<style>
	.wordmark {
		display: flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: var(--wm-size);
		font-weight: 500;
		letter-spacing: -0.02em;
		text-decoration: none;
		color: var(--text);
	}
	.org {
		color: var(--faint);
	}
	.slash {
		color: var(--accent);
	}
	.caret {
		display: inline-block;
		width: var(--wm-caret-w);
		height: var(--wm-caret-h);
		margin-left: 6px;
		background: var(--accent);
		animation: blink 1.15s step-end infinite;
	}
	@keyframes blink {
		0%,
		55% {
			opacity: 1;
		}
		56%,
		100% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.caret {
			animation: none;
		}
	}
	@media (max-width: 900px) {
		.wordmark {
			font-size: 15px;
			white-space: nowrap;
		}
		.caret {
			width: 8px;
			height: 17px;
			margin-left: 5px;
		}
	}
</style>
