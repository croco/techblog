---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import TagChip from '../components/TagChip.astro';
import Base from './Base.astro';
import { SITE_TITLE } from '../consts';
import { slugify } from '../utils/posts';

interface Props {
	post: CollectionEntry<'blog'>;
	/** 1つ古い記事。無ければ省略 */
	older?: CollectionEntry<'blog'>;
}

const { post, older } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, author, tags } = post.data;

// 元画像より大きく引き伸ばさない。表示枠は最大 1200px なので、
// 2x を狙って 1600px を上限にする。
const heroWidth = heroImage ? Math.min(heroImage.width, 1600) : 0;
const heroHeight = Math.round((heroWidth * 17) / 40);
---

<Base
	title={`${title} — ${SITE_TITLE}`}
	description={description}
	image={heroImage}
>
	<article>
		{
			heroImage && (
				<div class="shell hero-wrap">
					<div class="hero">
						<Image width={heroWidth} height={heroHeight} src={heroImage} alt="" />
					</div>
				</div>
			)
		}
		<div class="shell shell--prose">
			<header class="head">
				<div class="date">
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<span class="updated">
								（最終更新 <FormattedDate date={updatedDate} />）
							</span>
						)
					}
				</div>
				<h1>{title}</h1>
				<div class="meta">
					<a href={`/author/${slugify(author)}/`} class="author">
						<span class="avatar" aria-hidden="true">{[...author][0]}</span>{author}
					</a>
					{tags.length > 0 && <span class="sep" aria-hidden="true"></span>}
					{tags.map((tag) => <TagChip tag={tag} />)}
				</div>
			</header>
			<div class="prose">
				<slot />
			</div>
			<nav class="post-nav">
				{
					older ? (
						<a href={`/${older.id}/`} class="navlink prev">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M14 6l-6 6 6 6" />
							</svg>
							前の記事
						</a>
					) : (
						<span />
					)
				}
				<a href="/articles/" class="navlink">記事一覧</a>
			</nav>
		</div>
	</article>
</Base>

<style>
	.hero-wrap {
		padding-top: 56px;
	}
	.hero {
		aspect-ratio: 40 / 17;
		border: 1px solid var(--border);
		border-radius: 12px;
		overflow: hidden;
		background: var(--raised);
	}
	.hero :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.head {
		padding: 56px 0 40px 0;
		border-bottom: 1px solid var(--border);
	}
	.date {
		font-family: var(--font-mono);
		font-size: 14px;
		letter-spacing: 0.02em;
		color: var(--faint);
	}
	.updated {
		margin-left: 8px;
	}
	.head h1 {
		margin: 16px 0 0 0;
		font-size: 2.441em;
		line-height: 1.25;
	}
	.meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 26px;
	}
	.author {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 2px 10px 2px 3px;
		border: 1px solid var(--border);
		border-radius: 4px;
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: 1.6;
		color: var(--dim);
		text-decoration: none;
		transition:
			border-color 0.18s ease,
			color 0.18s ease;
	}
	.author:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.avatar {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 20px;
		height: 20px;
		border-radius: 3px;
		background: var(--surface);
		color: var(--accent);
		font-size: 12px;
	}
	.sep {
		width: 1px;
		height: 18px;
		background: var(--border);
	}
	.prose {
		padding-top: 48px;
	}
	.prose :global(p) {
		margin: 0 0 34px 0;
		line-height: 1.85;
	}
	.prose :global(h2) {
		margin: 56px 0 24px 0;
		font-size: 1.563em;
		line-height: 1.3;
	}
	.prose :global(h3) {
		margin: 44px 0 20px 0;
		font-size: 1.25em;
	}
	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 34px 0;
		padding-left: 1.4em;
	}
	.prose :global(li) {
		margin-bottom: 0.5em;
	}
	.prose :global(img) {
		border-radius: 8px;
	}
	.prose :global(pre) {
		margin: 0 0 34px 0;
	}
	.post-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		margin-top: 72px;
		padding-top: 32px;
		border-top: 1px solid var(--border);
	}
	.navlink {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-mono);
		font-size: 14px;
		color: var(--dim);
		text-decoration: none;
		transition: color 0.18s ease;
	}
	.navlink:hover {
		color: var(--text);
	}
	@media (max-width: 900px) {
		.hero-wrap {
			padding-top: 28px;
		}
		.head {
			padding: 36px 0 28px 0;
		}
		.prose {
			padding-top: 32px;
		}
	}
</style>
