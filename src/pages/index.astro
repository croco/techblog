---
import Base from '../layouts/Base.astro';
import PostGrid from '../components/PostGrid.astro';
import { SITE_DESCRIPTION, SITE_TITLE, TOP_COUNT } from '../consts';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
const latest = posts.slice(0, TOP_COUNT);
const hasMore = posts.length > TOP_COUNT;
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main class="shell">
		<section class="lead">
			<h1>読んでも出てこない<br />不具合の話をする。</h1>
			<p>
				croco の技術ブログです。社内のリポジトリを1つずつ棚卸しして、そこで実際にやったことを記事にしています。うまくいった設計だけでなく、どこで詰まって、なぜそう直したのかまで書きます。
			</p>
		</section>
		<section>
			<div class="label">
				<span>LATEST</span>
				<span class="rule"></span>
			</div>
			<PostGrid posts={latest} />
			{
				hasMore && (
					<a href="/articles/" class="more">
						その他の記事
						<svg
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M5 12h13" />
							<path d="M13 6l6 6-6 6" />
						</svg>
					</a>
				)
			}
		</section>
	</main>
</Base>

<style>
	.lead {
		max-width: var(--measure);
		padding: 96px 0 80px 0;
	}
	.lead h1 {
		margin: 0;
		line-height: 1.15;
	}
	.lead p {
		margin: 30px 0 0 0;
		line-height: 1.75;
		color: var(--dim);
	}
	.label {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-bottom: 28px;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.16em;
		color: var(--faint);
	}
	.rule {
		flex-grow: 1;
		height: 1px;
		background: var(--border);
	}
	.more {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		margin-top: 56px;
		padding: 24px;
		border: 1px solid var(--border);
		border-radius: 8px;
		font-family: var(--font-mono);
		font-size: 16px;
		color: var(--accent);
		text-decoration: none;
		transition:
			border-color 0.18s ease,
			background 0.18s ease;
	}
	.more:hover {
		border-color: var(--accent);
		background: var(--surface);
	}
	@media (max-width: 900px) {
		.lead {
			padding: 48px 0 44px 0;
		}
		.lead h1 br {
			display: none;
		}
	}
</style>
