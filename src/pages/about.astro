---
import Base from '../layouts/Base.astro';
import { SITE_TITLE } from '../consts';
import { getAuthors, getPosts } from '../utils/posts';

const posts = await getPosts();
const authors = await getAuthors();
---

<Base
	title={`このブログについて — ${SITE_TITLE}`}
	description="croco techblog の目的と、記事の書き方・公開の流れ。"
	current="about"
>
	<main class="shell shell--prose">
		<header class="head">
			<div class="eyebrow">/about/</div>
			<h1>このブログについて</h1>
		</header>
		<div class="prose">
			<p>
				croco の技術ブログです。社内で動いているリポジトリを1つずつ取り上げて、そこで実際にやったことを記事にしています。
			</p>
			<p>
				書き方は決まっています。まずリポジトリのコードやアイデアについて話し、その内容を記事の下書きに起こし、フロントマターを整えて
				<code>main</code> に push する。あとは CI がビルドして公開します。
			</p>
			<p>
				扱うのは、うまくいった設計だけではありません。むしろ、読んでも出てこない類の不具合 —
				設定が1箇所ずれていた、ビルドは緑なのに成果物が空だった —
				のほうが、書き残す価値があると思っています。
			</p>
			<dl class="facts">
				<div>
					<dt>運営</dt>
					<dd>croco</dd>
				</div>
				<div>
					<dt>執筆</dt>
					<dd>
						{
							authors.map((a, i) => (
								<>
									{i > 0 && '、'}
									<a href={`/author/${a.slug}/`}>{a.name}</a>
								</>
							))
						}
					</dd>
				</div>
				<div>
					<dt>記事数</dt>
					<dd>{posts.length} 件</dd>
				</div>
				<div>
					<dt>更新</dt>
					<dd><a href="/rss.xml">rss.xml</a></dd>
				</div>
			</dl>
		</div>
	</main>
</Base>

<style>
	.head {
		padding: 88px 0 40px 0;
		border-bottom: 1px solid var(--border);
	}
	.head h1 {
		margin: 14px 0 0 0;
		font-size: 2.441em;
	}
	.prose {
		padding-top: 48px;
	}
	.prose p {
		margin: 0 0 34px 0;
		line-height: 1.85;
	}
	.facts {
		margin: 8px 0 0 0;
		border: 1px solid var(--border);
		border-radius: 8px;
		overflow: hidden;
	}
	.facts > div {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		padding: 16px 20px;
		border-bottom: 1px solid var(--border-soft);
		font-family: var(--font-mono);
		font-size: 15px;
	}
	.facts > div:last-child {
		border-bottom: 0;
	}
	.facts dt {
		color: var(--faint);
	}
	.facts dd {
		margin: 0;
		text-align: right;
	}
	@media (max-width: 900px) {
		.head {
			padding: 48px 0 28px 0;
		}
		.prose {
			padding-top: 32px;
		}
	}
</style>
