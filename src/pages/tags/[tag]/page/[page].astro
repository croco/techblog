---
import Listing from '../../../../components/Listing.astro';
import Base from '../../../../layouts/Base.astro';
import { PER_PAGE, SITE_TITLE } from '../../../../consts';
import { getTags, pageCount, pageSlice } from '../../../../utils/posts';

export async function getStaticPaths() {
	const tags = await getTags();
	return tags.flatMap((t) =>
		Array.from({ length: pageCount(t.posts.length) }, (_, i) => i + 1).map((page) => ({
			params: { tag: t.slug, page: String(page) },
			props: { page, name: t.name },
		})),
	);
}

const { page, name } = Astro.props;
const { tag } = Astro.params;
const posts = (await getTags()).find((t) => t.slug === tag)!.posts;
const shown = pageSlice(posts, page);
const from = (page - 1) * PER_PAGE + 1;
const to = from + shown.length - 1;
const canonical = page === 1 ? `/tags/${tag}/` : undefined;
---

<Base
	title={`#${name} (${page}ページ目) — ${SITE_TITLE}`}
	description={`${name} タグの記事一覧。`}
	canonical={canonical}
	activeTag={tag}
>
	<Listing
		eyebrow={`/tags/${tag}/page/${page}/`}
		meta={`${posts.length} 件 · ${from}–${to} 件目を表示`}
		posts={shown}
		total={posts.length}
		current={page}
		base={`/tags/${tag}/`}
	>
		<h1 slot="heading"><span class="hash">#</span>{name}</h1>
	</Listing>
</Base>

<style>
	.hash {
		color: var(--accent);
	}
</style>
